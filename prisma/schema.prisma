generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum PlotUnit {
  M
  FT
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  plots     Plot[]
  projects  Project[]
  profiles  HomeProfile[]
  feedback  Feedback[]

  @@map("users")
}

model Plot {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  widthM    Float
  depthM    Float
  unit      PlotUnit @default(M)
  widthRaw  Float
  depthRaw  Float
  openSides Int      @default(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects  Project[]

  @@unique([ownerId, widthM, depthM])
  @@index([ownerId])
  @@map("plots")
}

model DesignTemplate {
  id                String   @id @default(uuid())
  slug              String   @unique
  name              String
  region            String?
  version           Int      @default(1)
  isActive          Boolean  @default(true)
  wallThicknessM    Float
  wallNote          String?
  circulationRatio  Float    @default(0.08)
  doorWidthM        Float    @default(0.9)
  staircase         Json
  roomDefaults      Json
  kitchenDefaults   Json
  bathDefaults      Json
  mandatoryDefaults Json
  createdAt         DateTime @default(now())
  profiles          HomeProfile[]

  @@map("design_templates")
}

model HomeProfile {
  id                   String         @id @default(uuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id])
  name                 String
  templateId           String?
  template             DesignTemplate? @relation(fields: [templateId], references: [id])
  templateSnapshot     Json
  floors               Int            @default(1)
  rooms                Json
  kitchen              Json?
  bathConnectivity     Json
  mandatoryRequirements Json
  maxCoverage          Float?
  focus                Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  projects             Project[]

  @@index([userId])
  @@map("home_profiles")
}

model Project {
  id            String         @id @default(uuid())
  ownerId       String
  owner         User           @relation(fields: [ownerId], references: [id])
  plotId        String
  plot          Plot           @relation(fields: [plotId], references: [id])
  homeProfileId String?
  homeProfile   HomeProfile?   @relation(fields: [homeProfileId], references: [id])
  name          String
  prefsSnapshot Json
  plotSnapshot  Json
  status        String         @default("ACTIVE")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  versions      DesignVersion[]

  @@index([ownerId])
  @@map("projects")
}

model DesignVersion {
  id            String          @id @default(uuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id])
  versionNumber Int
  parentId      String?
  parent        DesignVersion?  @relation("VersionTree", fields: [parentId], references: [id])
  children      DesignVersion[] @relation("VersionTree")
  plotSnapshot  Json
  prefsSnapshot Json
  changeRequest Json?
  layout        Json
  metrics       Json
  diagnostics   Json?
  seed          Int?
  status        String          @default("GENERATED")
  createdAt     DateTime        @default(now())
  feedback      Feedback[]

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@map("design_versions")
}

model Feedback {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  designVersionId String
  designVersion   DesignVersion @relation(fields: [designVersionId], references: [id])
  rating          Int?
  comment         String?
  tags            Json
  likes           Json
  dislikes        Json
  createdAt       DateTime      @default(now())

  @@index([userId])
  @@index([designVersionId])
  @@map("feedback")
}